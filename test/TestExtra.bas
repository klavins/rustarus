10 REM ================================
20 REM   EXTRA TEST SUITE
30 REM   Tests features not in TestAll
40 REM ================================
50 LET PASS = 0
60 LET FAIL = 0
70 LET TEST = 0
100 REM ---- BARE ASSIGNMENT ----
110 LET TEST = TEST + 1
120 X = 99
130 IF X = 99 THEN GOSUB 9000
140 IF X <> 99 THEN GOSUB 9100
200 REM ---- PRINT SEMICOLON ----
210 LET TEST = TEST + 1
220 PRINT "AB";
230 PRINT "CD"
240 GOSUB 9000
300 REM ---- AND/OR/NOT ----
310 LET TEST = TEST + 1
320 IF 1 AND 1 THEN GOSUB 9000
330 IF 1 AND 0 THEN GOSUB 9100
340 LET TEST = TEST + 1
350 IF 1 OR 0 THEN GOSUB 9000
360 IF 0 OR 0 THEN GOSUB 9100
370 LET TEST = TEST + 1
380 IF NOT 0 THEN GOSUB 9000
390 IF NOT 1 THEN GOSUB 9100
400 LET TEST = TEST + 1
410 IF (1 AND 0) OR 1 THEN GOSUB 9000
420 IF (1 AND 0) OR 0 THEN GOSUB 9100
500 REM ---- UNARY MINUS ----
510 LET TEST = TEST + 1
520 LET X = -5
530 IF X = -5 THEN GOSUB 9000
540 IF X <> -5 THEN GOSUB 9100
550 LET TEST = TEST + 1
560 IF -3 * 2 = -6 THEN GOSUB 9000
570 IF -3 * 2 <> -6 THEN GOSUB 9100
600 REM ---- IF/THEN IMPLICIT GOTO ----
610 LET TEST = TEST + 1
620 LET X = 1
630 IF X = 1 THEN 660
640 GOSUB 9100
650 GOTO 670
660 GOSUB 9000
670 REM
700 REM ---- ON GOSUB ----
710 LET TEST = TEST + 1
720 LET X = 0
730 ON 2 GOSUB 8100, 8200, 8300
740 IF X = 20 THEN GOSUB 9000
750 IF X <> 20 THEN GOSUB 9100
800 REM ---- NESTED IF ----
810 LET TEST = TEST + 1
820 LET X = 5
830 IF X > 3 THEN IF X < 10 THEN GOSUB 9000
840 IF X <= 3 THEN GOSUB 9100
900 REM ---- END STATEMENT ----
910 LET TEST = TEST + 1
920 LET X = 0
930 GOSUB 8400
940 IF X = 1 THEN GOSUB 9000
950 IF X <> 1 THEN GOSUB 9100
1000 REM ---- DATA/READ/RESTORE ----
1010 DATA 10, 20, 30, 40, 50, 60
1020 LET TEST = TEST + 1
1030 READ A
1040 READ B
1050 IF A + B = 30 THEN GOSUB 9000
1060 IF A + B <> 30 THEN GOSUB 9100
1070 LET TEST = TEST + 1
1080 RESTORE
1090 READ C
1100 IF C = 10 THEN GOSUB 9000
1110 IF C <> 10 THEN GOSUB 9100
1120 LET TEST = TEST + 1
1130 RESTORE
1140 READ X, Y, Z
1150 IF X + Y + Z = 60 THEN GOSUB 9000
1160 IF X + Y + Z <> 60 THEN GOSUB 9100
1200 REM ---- STRING PRINT ----
1210 LET TEST = TEST + 1
1220 DIM S$(30)
1230 LET S$ = "WORKS"
1240 PRINT S$
1250 GOSUB 9000
1300 REM ---- FOR NEGATIVE STEP ----
1310 LET TEST = TEST + 1
1320 LET S = 0
1330 FOR I = 5 TO 1 STEP -1
1340 LET S = S + I
1350 NEXT I
1360 IF S = 15 THEN GOSUB 9000
1370 IF S <> 15 THEN GOSUB 9100
1400 REM ---- DELAY (no crash) ----
1410 LET TEST = TEST + 1
1420 DELAY 10
1430 GOSUB 9000
1500 REM ---- POKE/PEEK ROUND TRIP ----
1510 LET TEST = TEST + 1
1520 POKE 0x70091, 123
1530 IF PEEK(0x70091) = 123 THEN GOSUB 9000
1540 IF PEEK(0x70091) <> 123 THEN GOSUB 9100
1550 POKE 0x70091, 0
5000 REM ================================
5010 PRINT ""
5020 PRINT "================================"
5030 PRINT "  RESULTS: ", PASS, " PASSED, ", FAIL, " FAILED"
5040 PRINT "  TOTAL:   ", PASS + FAIL, " TESTS"
5050 PRINT "================================"
5060 IF FAIL = 0 THEN PRINT "  ALL TESTS PASSED!"
5070 IF FAIL > 0 THEN PRINT "  *** FAILURES DETECTED ***"
5080 QUIT
