10 PRINT "Hold keys to test. ESC to quit."
20 PRINT ""
30 IF PEEK(0x70001) = 1 THEN GOTO 200
40 IF PEEK(0x70011) = 1 THEN PRINT "W ";
50 IF PEEK(0x70048) = 1 THEN PRINT "UP ";
60 IF PEEK(0x70050) = 1 THEN PRINT "DOWN ";
70 IF PEEK(0x7004B) = 1 THEN PRINT "LEFT ";
80 IF PEEK(0x7004D) = 1 THEN PRINT "RIGHT ";
90 IF PEEK(0x70047) = 1 THEN PRINT "HOME ";
100 IF PEEK(0x7004F) = 1 THEN PRINT "END ";
110 IF PEEK(0x70049) = 1 THEN PRINT "PGUP ";
120 IF PEEK(0x70051) = 1 THEN PRINT "PGDN ";
130 IF PEEK(0x70053) = 1 THEN PRINT "DEL ";
140 DELAY 150
150 GOTO 30
200 PRINT ""
210 PRINT "DONE"
220 QUIT
